{
  "manifest_version": 3,
  "name": "Spin Elements",
  "version": "1.0",

  "description": "Makes any element the user passes the mouse over start to spin.",

  "browser_specific_settings": {
    "gecko": {
      "id": "spin@marcus.davi",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["spin.js"]
    }
  ]
}